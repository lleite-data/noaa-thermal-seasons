        <mxCell id="subtitle" parent="1" style="text;html=1;fontFamily=Helvetica;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#444444;" value="ELT pipeline. Extract and load: Python on GitHub Actions. Transform: dbt (orchestrated by dbt Cloud, executed in Snowflake). Serve: Streamlit in Snowflake. One GitHub repo holds all code." vertex="1">
          <mxGeometry height="22" width="1360" x="40" y="56" as="geometry" />
        </mxCell>
        <mxCell id="flow" parent="1" style="text;html=1;fontFamily=Helvetica;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;" value="&lt;b&gt;Flow:&lt;/b&gt;&amp;nbsp; &lt;b&gt;①&lt;/b&gt; scheduler triggers the ingest &amp;nbsp;→&amp;nbsp; &lt;b&gt;②&lt;/b&gt; download only new or changed files &amp;nbsp;→&amp;nbsp; &lt;b&gt;③&lt;/b&gt; PUT: upload files to the stage &amp;nbsp;→&amp;nbsp; &lt;b&gt;④&lt;/b&gt; COPY INTO: load the files&#39; rows into raw &amp;nbsp;→&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;⑤&lt;/b&gt; dbt build: raw → staging → intermediate → marts, with tests &amp;nbsp;→&amp;nbsp; &lt;b&gt;⑥&lt;/b&gt; dashboard and analysts query the marts" vertex="1">
          <mxGeometry height="44" width="1420" x="40" y="90" as="geometry" />
