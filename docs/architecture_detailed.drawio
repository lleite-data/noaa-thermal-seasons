<mxfile host="app.diagrams.net"><diagram name="Architecture" id="arch"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2230" pageHeight="918" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;NOAA LCD thermal seasons: data architecture&lt;/b&gt;" style="text;html=1;fontFamily=Helvetica;fontSize=22;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="32" as="geometry"/></mxCell><mxCell id="subtitle" value="ELT pipeline. Extract and load: Python on GitHub Actions. Transform: dbt (orchestrated by dbt Cloud, executed in Snowflake). Serve: Streamlit in Snowflake. One GitHub repo holds all code." style="text;html=1;fontFamily=Helvetica;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1360" height="22" as="geometry"/></mxCell><mxCell id="flow" value="&lt;b&gt;Flow:&lt;/b&gt;&amp;nbsp; &lt;b&gt;①&lt;/b&gt; scheduler triggers the ingest &amp;nbsp;→&amp;nbsp; &lt;b&gt;②&lt;/b&gt; download only new or changed files &amp;nbsp;→&amp;nbsp; &lt;b&gt;③&lt;/b&gt; PUT: upload files to the stage &amp;nbsp;→&amp;nbsp; &lt;b&gt;④&lt;/b&gt; COPY INTO: load the files' rows into raw &amp;nbsp;→&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;⑤&lt;/b&gt; dbt build: raw → staging → intermediate → marts, with tests &amp;nbsp;→&amp;nbsp; &lt;b&gt;⑥&lt;/b&gt; dashboard and analysts query the marts" style="text;html=1;fontFamily=Helvetica;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1420" height="44" as="geometry"/></mxCell><mxCell id="legend" value="" style="rounded=1;arcSize=4;html=1;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="1530" y="18" width="660" height="162" as="geometry"/></mxCell><mxCell id="legend_t" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1544" y="26" width="200" height="20" as="geometry"/></mxCell><mxCell id="lg_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1546" y="62" as="sourcePoint"/><mxPoint x="1590" y="62" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lg_t1" value="data flow (numbered steps as in the flow line)" style="text;html=1;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1600" y="54" width="300" height="18" as="geometry"/></mxCell><mxCell id="lg_e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#777777;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1546" y="88" as="sourcePoint"/><mxPoint x="1590" y="88" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lg_t2" value="trigger, metadata or check (no data moved)" style="text;html=1;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1600" y="80" width="300" height="18" as="geometry"/></mxCell><mxCell id="lg_s1" value="" style="rounded=1;arcSize=10;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1550" y="106" width="34" height="16" as="geometry"/></mxCell><mxCell id="lg_t3" value="identity &amp; access: who runs it, with which role and warehouse" style="text;html=1;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1600" y="105" width="360" height="18" as="geometry"/></mxCell><mxCell id="lg_s2" value="" style="rounded=1;arcSize=10;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1550" y="128" width="34" height="16" as="geometry"/></mxCell><mxCell id="lg_t4" value="tests, checks and alerts" style="text;html=1;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1600" y="127" width="300" height="18" as="geometry"/></mxCell><mxCell id="lg_s3" value="" style="rounded=1;arcSize=10;html=1;fillColor=#ffffff;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="1550" y="150" width="34" height="16" as="geometry"/></mxCell><mxCell id="lg_t5" value="designed for scale, not built" style="text;html=1;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1600" y="149" width="300" height="18" as="geometry"/></mxCell><mxCell id="c1" value="1 · Source: NOAA (NCEI)" style="swimlane;html=1;startSize=36;rounded=1;arcSize=2;fillColor=#f5f5f5;strokeColor=#666666;swimlaneFillColor=#ffffff;fontFamily=Helvetica;fontSize=14;fontStyle=1;align=left;spacingLeft=12;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40" y="196" width="260" height="560" as="geometry"/></mxCell><mxCell id="src_lcd" value="&lt;b&gt;LCD v2 data files&lt;/b&gt;&lt;br&gt;one CSV per station per year&lt;br&gt;LCD_&amp;lt;station&amp;gt;_&amp;lt;year&amp;gt;.csv&lt;br&gt;hourly, daily and monthly rows&lt;br&gt;in the same file&lt;br&gt;public HTTPS object store with&lt;br&gt;size + Last-Modified headers" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;" vertex="1" parent="c1"><mxGeometry x="12" y="52" width="236" height="128" as="geometry"/></mxCell><mxCell id="src_st" value="&lt;b&gt;Station list&lt;/b&gt;&lt;br&gt;fixed-width text file:&lt;br&gt;IDs, names, coordinates&lt;br&gt;reloaded in the monthly full scan" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;" vertex="1" parent="c1"><mxGeometry x="12" y="200" width="236" height="80" as="geometry"/></mxCell><mxCell id="src_scale" value="&lt;b&gt;Scale-up path&lt;/b&gt;&lt;br&gt;&lt;b&gt;designed, not built&lt;/b&gt;&lt;br&gt;yearly archives (tar.gz) +&lt;br&gt;inventory JSON instead of one&lt;br&gt;request per file; ~6,100 US&lt;br&gt;stations, &amp;gt;1 TB: keep files in&lt;br&gt;object storage, external stage +&lt;br&gt;Snowpipe, load daily rows only" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;dashed=1;" vertex="1" parent="c1"><mxGeometry x="12" y="300" width="236" height="148" as="geometry"/></mxCell><mxCell id="c2" value="2 · Trigger &amp;amp; ingest: GitHub Actions" style="swimlane;html=1;startSize=36;rounded=1;arcSize=2;fillColor=#e1d5e7;strokeColor=#9673a6;swimlaneFillColor=#ffffff;fontFamily=Helvetica;fontSize=14;fontStyle=1;align=left;spacingLeft=12;collapsible=0;" vertex="1" parent="1"><mxGeometry x="350" y="196" width="370" height="560" as="geometry"/></mxCell><mxCell id="trg_p" value="&lt;b&gt;Primary: cron-job.org&lt;/b&gt;&lt;br&gt;every 6 h: 04, 10, 16, 22 UTC&lt;br&gt;1st of month: full scan&lt;br&gt;calls the GitHub API with a&lt;br&gt;token limited to this repo" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;" vertex="1" parent="c2"><mxGeometry x="12" y="52" width="167" height="100" as="geometry"/></mxCell><mxCell id="trg_b" value="&lt;b&gt;Backup: GitHub cron&lt;/b&gt;&lt;br&gt;07:17 and 19:17 UTC&lt;br&gt;2nd of month: full scan&lt;br&gt;GitHub runs it late (hours),&lt;br&gt;so it is only a safety net" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;" vertex="1" parent="c2"><mxGeometry x="191" y="52" width="167" height="100" as="geometry"/></mxCell><mxCell id="ingest" value="&lt;b&gt;ingest.yml → ingest.py (runs on a GitHub runner)&lt;/b&gt;&lt;br&gt;&lt;b&gt;Scope&lt;/b&gt;&lt;br&gt;regular run: previous + current year&lt;br&gt;full scan: 2006 → today + station list&lt;br&gt;&lt;b&gt;Steps&lt;/b&gt;&lt;br&gt;· HEAD each file, compare with INGEST_MANIFEST&lt;br&gt;· download only new or changed files&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;(MD5 check + CSV header guard)&lt;br&gt;· new columns? → logged in SCHEMA_DRIFT_LOG&lt;br&gt;· ③ PUT: upload the files to LCD_STAGE&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;(one parallel upload per year)&lt;br&gt;· ④ COPY INTO: load their rows into raw&lt;br&gt;· write INGEST_RUN_LOG + a summary on the&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;GitHub run page; exit 1 (red run) on load&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;errors or &amp;gt; 5% source errors&lt;br&gt;&lt;b&gt;Safe to rerun&lt;/b&gt;&lt;br&gt;one run at a time; nothing is loaded twice" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;" vertex="1" parent="c2"><mxGeometry x="12" y="180" width="346" height="262" as="geometry"/></mxCell><mxCell id="ingest_sec" value="&lt;b&gt;Runs as INGEST_SVC&lt;/b&gt;&lt;br&gt;service user, key-pair login&lt;br&gt;LOADER_ROLE · LOAD_WH" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;" vertex="1" parent="c2"><mxGeometry x="12" y="484" width="346" height="62" as="geometry"/></mxCell><mxCell id="c3" value="3 · Snowflake raw: CLIMATE_RAW.LCD" style="swimlane;html=1;startSize=36;rounded=1;arcSize=2;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;fontFamily=Helvetica;fontSize=14;fontStyle=1;align=left;spacingLeft=12;collapsible=0;" vertex="1" parent="1"><mxGeometry x="770" y="196" width="320" height="560" as="geometry"/></mxCell><mxCell id="stage" value="&lt;b&gt;LCD_STAGE (internal stage)&lt;/b&gt;&lt;br&gt;file storage inside Snowflake&lt;br&gt;v2/&amp;lt;year&amp;gt;/LCD_*.csv.gz&lt;br&gt;(not the same as dbt's staging layer)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;" vertex="1" parent="c3"><mxGeometry x="12" y="52" width="296" height="66" as="geometry"/></mxCell><mxCell id="raw_obs" value="&lt;b&gt;RAW_LCD_OBSERVATIONS&lt;/b&gt;&lt;br&gt;one row per CSV line, as delivered&lt;br&gt;all 125 columns as text&lt;br&gt;+ _source_file, _file_row_number, _loaded_at&lt;br&gt;new NOAA columns are added automatically" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;" vertex="1" parent="c3"><mxGeometry x="12" y="150" width="296" height="80" as="geometry"/></mxCell><mxCell id="raw_st" value="&lt;b&gt;RAW_LCD_STATIONS&lt;/b&gt;&lt;br&gt;parsed station list" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;" vertex="1" parent="c3"><mxGeometry x="12" y="242" width="296" height="40" as="geometry"/></mxCell><mxCell id="manifest" value="&lt;b&gt;INGEST_MANIFEST&lt;/b&gt;&lt;br&gt;last seen size, date and hash per file" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;" vertex="1" parent="c3"><mxGeometry x="12" y="294" width="296" height="40" as="geometry"/></mxCell><mxCell id="drift" value="&lt;b&gt;SCHEMA_DRIFT_LOG&lt;/b&gt;&lt;br&gt;every column change NOAA makes" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;" vertex="1" parent="c3"><mxGeometry x="12" y="346" width="296" height="40" as="geometry"/></mxCell><mxCell id="runlog" value="&lt;b&gt;INGEST_RUN_LOG&lt;/b&gt;&lt;br&gt;one row per run: files, rows, result" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;" vertex="1" parent="c3"><mxGeometry x="12" y="398" width="296" height="40" as="geometry"/></mxCell><mxCell id="alert" value="&lt;b&gt;PIPELINE_STALENESS_ALERT&lt;/b&gt;&lt;br&gt;Snowflake Alert, every hour (CLIMATE_WH)&lt;br&gt;emails if: no successful ingest in 12 h,&lt;br&gt;or the marts were not rebuilt in 26 h" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;" vertex="1" parent="c3"><mxGeometry x="12" y="466" width="296" height="80" as="geometry"/></mxCell><mxCell id="c4" value="4 · Transform: dbt → CLIMATE_ANALYTICS" style="swimlane;html=1;startSize=36;rounded=1;arcSize=2;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#ffffff;fontFamily=Helvetica;fontSize=14;fontStyle=1;align=left;spacingLeft=12;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1140" y="196" width="680" height="560" as="geometry"/></mxCell><mxCell id="job" value="&lt;b&gt;dbt Cloud job daily_build · every day 11:30 UTC&lt;/b&gt;&lt;br&gt;1. dbt source freshness  →  2. dbt build: models + tests in dependency order&lt;br&gt;dbt Cloud only orchestrates: every query runs inside Snowflake" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;" vertex="1" parent="c4"><mxGeometry x="12" y="52" width="452" height="62" as="geometry"/></mxCell><mxCell id="dbt_sec" value="&lt;b&gt;Runs as DBT_SVC&lt;/b&gt;&lt;br&gt;service user, key-pair login&lt;br&gt;DBT_ROLE · TRANSFORM_WH" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;" vertex="1" parent="c4"><mxGeometry x="476" y="52" width="192" height="62" as="geometry"/></mxCell><mxCell id="stg" value="&lt;b&gt;STAGING  (clean the raw text)&lt;/b&gt;&lt;br&gt;stg_lcd__daily_observations&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;daily summary rows; incremental:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;only new rows are merged&lt;br&gt;stg_lcd__hourly_temperatures&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;hourly readings (view)&lt;br&gt;stg_lcd__stations (view)&lt;br&gt;&lt;br&gt;&lt;b&gt;What it does&lt;/b&gt;&lt;br&gt;text → numbers, NOAA flags&lt;br&gt;parsed, latest file version kept" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;" vertex="1" parent="c4"><mxGeometry x="12" y="132" width="210" height="270" as="geometry"/></mxCell><mxCell id="int" value="&lt;b&gt;INTERMEDIATE  (the method)&lt;/b&gt;&lt;br&gt;int_daily_temps_from_hourly&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;rebuilds days NOAA left blank&lt;br&gt;int_station_daily_series&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;one row per calendar day;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;bad values removed; 7-day mean&lt;br&gt;int_station_thresholds&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;cool / warm level per station&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;(fixed 2006–2020 baseline)&lt;br&gt;int_station_day_climatology&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;normal temperature per day&lt;br&gt;int_season_onsets&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;season start: crosses the level&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;and stays 5 days" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;" vertex="1" parent="c4"><mxGeometry x="234" y="132" width="210" height="270" as="geometry"/></mxCell><mxCell id="marts" value="&lt;b&gt;MARTS  (answers, read by users)&lt;/b&gt;&lt;br&gt;&lt;b&gt;Q1 · Q2: season starts and trends&lt;/b&gt;&lt;br&gt;fct_season_onset&lt;br&gt;mart_season_onset_trends&lt;br&gt;mart_season_trend_summary&lt;br&gt;mart_warm_season_length&lt;br&gt;&lt;b&gt;Q3: outliers&lt;/b&gt;&lt;br&gt;fct_weather_outliers&lt;br&gt;fct_daily_weather&lt;br&gt;&lt;b&gt;Shared&lt;/b&gt;&lt;br&gt;dim_station&lt;br&gt;mart_ingest_runs (live run log)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;" vertex="1" parent="c4"><mxGeometry x="456" y="132" width="210" height="270" as="geometry"/></mxCell><mxCell id="ref" value="&lt;b&gt;REFERENCE  (dbt seeds: CSV files in the repo)&lt;/b&gt;&lt;br&gt;stations_of_interest: the 12 stations and their region&lt;br&gt;season_definitions: date window and direction per season" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;" vertex="1" parent="c4"><mxGeometry x="12" y="414" width="432" height="54" as="geometry"/></mxCell><mxCell id="tests" value="&lt;b&gt;Tests and checks on every run&lt;/b&gt;&lt;br&gt;Stop the job (error): no successful ingest in 30 h · raw → staging row reconciliation · unique / not null keys ·&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;hourly-rebuild accuracy · quality guard · unit tests for the season-start rule&lt;br&gt;Warn only: no new NOAA data in 7 days · station-year completeness · station recency · quality alarm" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;" vertex="1" parent="c4"><mxGeometry x="12" y="480" width="656" height="68" as="geometry"/></mxCell><mxCell id="c5" value="5 · Consume" style="swimlane;html=1;startSize=36;rounded=1;arcSize=2;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#ffffff;fontFamily=Helvetica;fontSize=14;fontStyle=1;align=left;spacingLeft=12;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1870" y="196" width="320" height="560" as="geometry"/></mxCell><mxCell id="app" value="&lt;b&gt;Streamlit dashboard in Snowflake&lt;/b&gt;&lt;br&gt;CLIMATE_ANALYTICS.APPS.&lt;br&gt;CLIMATE_SEASONS_DASHBOARD&lt;br&gt;tabs: Season start · Shift trends ·&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Outliers · Pipeline health &amp;amp; cost&lt;br&gt;data: live, read-only queries on MARTS&lt;br&gt;code: deployed by CI on every merge" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;" vertex="1" parent="c5"><mxGeometry x="12" y="52" width="296" height="126" as="geometry"/></mxCell><mxCell id="app_sec" value="&lt;b&gt;Runs as CLIMATE_DASHBOARD_ROLE&lt;/b&gt;&lt;br&gt;read MARTS + cost views, nothing else&lt;br&gt;REPORTING_WH · container runtime" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;" vertex="1" parent="c5"><mxGeometry x="12" y="190" width="296" height="62" as="geometry"/></mxCell><mxCell id="analysts" value="&lt;b&gt;Analysts (SQL)&lt;/b&gt;&lt;br&gt;REPORTER_ROLE: read MARTS only,&lt;br&gt;no access to raw · REPORTING_WH" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;" vertex="1" parent="c5"><mxGeometry x="12" y="280" width="296" height="62" as="geometry"/></mxCell><mxCell id="exposure" value="&lt;b&gt;dbt exposure&lt;/b&gt;&lt;br&gt;the dashboard is declared in dbt,&lt;br&gt;so it shows in the lineage graph" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;" vertex="1" parent="c5"><mxGeometry x="12" y="370" width="296" height="62" as="geometry"/></mxCell><mxCell id="cicd" value="&lt;b&gt;CI/CD: GitHub (main = production)&lt;/b&gt;&lt;br&gt;ci.yml, every pull request and push: ruff (ingest, dashboard), pytest (ingest), actionlint, dbt parse&lt;br&gt;dashboard.yml, on changes to dashboard/: smoke test with mocked Snowflake, then&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;snow streamlit deploy as DASHBOARD_DEPLOY_SVC (key pair)&lt;br&gt;dbt Cloud: developers build in personal schemas; the Production job builds main&lt;br&gt;Snowflake setup (roles, warehouses, alert) versioned in snowflake/*.sql, run by an admin" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="786" width="696" height="112" as="geometry"/></mxCell><mxCell id="ops" value="&lt;b&gt;Monitoring &amp;amp; alerting&lt;/b&gt;&lt;br&gt;Email if no successful ingest in 12 h or marts older than 26 h (Snowflake alert)&lt;br&gt;Email on any failed run: cron-job.org, GitHub Actions&lt;br&gt;Freshness: pipeline broken (no run in 30 h) = error · NOAA quiet (no new data in 7 days) = warning&lt;br&gt;Dashboard tab 'Pipeline health &amp;amp; cost': last load, last build, failed runs, credits" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="766" y="786" width="696" height="112" as="geometry"/></mxCell><mxCell id="sec" value="&lt;b&gt;Security &amp;amp; cost&lt;/b&gt;&lt;br&gt;Production runs only as service users (key pair): INGEST_SVC · DBT_SVC · DASHBOARD_DEPLOY_SVC&lt;br&gt;Least privilege: LOADER_ROLE writes raw · DBT_ROLE reads raw, writes analytics · REPORTER_ROLE reads marts&lt;br&gt;One warehouse per job: LOAD_WH · TRANSFORM_WH · REPORTING_WH (CLIMATE_WH: setup and alert)&lt;br&gt;Resource monitor: 20 credits/month, email at 75%, suspend at 100%&lt;br&gt;Private keys only in GitHub secrets / dbt Cloud, never in the repo · public NOAA data, no personal data" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1492" y="786" width="698" height="112" as="geometry"/></mxCell><mxCell id="f1a" value="①" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#777777;exitX=0.5;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="trg_p" target="ingest"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f1b" value="①" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#777777;exitX=0.5;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="1" source="trg_b" target="ingest"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f2a" value="②" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.85;entryX=0;entryY=0.2;" edge="1" parent="1" source="src_lcd" target="ingest"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f2b" value="②" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.45;" edge="1" parent="1" source="src_st" target="ingest"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f3" value="③" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.12;entryX=0;entryY=0.5;" edge="1" parent="1" source="ingest" target="stage"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f4" value="④" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="stage" target="raw_obs"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#777777;exitX=1;exitY=0.78;entryX=0;entryY=0.5;" edge="1" parent="1" source="ingest" target="manifest"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#777777;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="runlog" target="alert"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f5a" value="⑤" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.2;" edge="1" parent="1" source="raw_obs" target="stg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f5b" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="raw_st" target="stg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f5c" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="stg" target="int"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f5d" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="int" target="marts"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f5e" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;exitX=0.75;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="ref" target="int"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f6a" value="⑥" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.2;entryX=0;entryY=0.5;" edge="1" parent="1" source="marts" target="app"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f6b" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.75;entryX=0;entryY=0.5;" edge="1" parent="1" source="marts" target="analysts"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>