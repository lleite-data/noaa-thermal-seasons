        <mxCell id="title" parent="1" style="text;html=1;fontFamily=Helvetica;fontSize=22;align=left;verticalAlign=top;whiteSpace=wrap;" value="&lt;b&gt;NOAA LCD thermal seasons: data architecture&lt;/b&gt;" vertex="1">
